name = "fatih-portfolio-ai-proxy"
main = "ask-worker.js"
compatibility_date = "2025-01-01"
routes = [
  { pattern = "ai.fatihgulen.com/api/*", zone_name = "fatihgulen.com" }
]

[[rules]]
type = "Text"
globs = ["../profile.md"]

[vars]
OPENAI_MODEL = "gpt-5.4"
ALLOWED_ORIGIN_SUFFIXES = ".fatihgulen-53.workers.dev"
